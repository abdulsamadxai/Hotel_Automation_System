# Hotel Automation API — copy to .env and fill in real values.
# Never commit a real .env: secrets live in the environment / Render dashboard.

# Port the API listens on (Render sets PORT itself).
PORT=3001

# PostgreSQL connection string. Local dev example:
DATABASE_URL=postgresql://user:password@localhost:5432/hotel_automation?schema=public

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Render this is generated by the Blueprint (see render.yaml).
JWT_SECRET=<generate-a-long-random-string>

# Allowed browser origins, comma-separated. Add the deployed Vercel URL
# when the frontend is live, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://hotel-automation-system.vercel.app
CORS_ORIGIN=http://localhost:5173

# Password for the 5 demo accounts created by `npm run seed`
# (admin@demo.hotel, owner@demo.hotel, manager@demo.hotel,
# housekeeping@demo.hotel, staff@demo.hotel). Required by the seed;
# leave empty here and set a real value in .env / Render. Never commit
# a real password.
SEED_DEMO_PASSWORD=
