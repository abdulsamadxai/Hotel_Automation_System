# Frontend (Vite) — copy to .env for local dev.
# Base URL of the backend API. Leave empty to use the default
# http://localhost:3001.
VITE_API_BASE_URL=http://localhost:3001

# Backend (backend/.env) — placeholders only; never commit real values.
# The backend refuses to boot without JWT_SECRET in any environment, and the
# seed (`cd backend && npm run seed`) exits unless SEED_DEMO_PASSWORD is set.
# DATABASE_URL=postgresql://user:password@localhost:5432/hotel_automation
# JWT_SECRET=change-me-to-a-long-random-secret
# CORS_ORIGIN=http://localhost:5173
# SEED_DEMO_PASSWORD=change-me
